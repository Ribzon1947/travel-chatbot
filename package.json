{
  "name": "travel-cost-chatbot",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "frontend":      "node frontend-server.js",
    "frontend:dev":  "node --watch frontend-server.js",
    "backend":       "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "backend:dev":   "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^140.0.0",
    "multer": "^2.0.0"
  }
}
